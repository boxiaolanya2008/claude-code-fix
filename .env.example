# ==============================================================================
# Claude Code Proxy — 环境变量配置
# ==============================================================================

# ---------- 目标 API 配置 ----------
# 实际调用的 API 密钥 (支持 OpenAI / Azure / 第三方兼容服务)
TARGET_API_KEY=sk-xxxx

# API 基础地址 (不含 /chat/completions)
# OpenAI:       https://api.openai.com/v1
# Azure:        https://<resource>.openai.azure.com/openai/deployments/<deploy>
# Ollama:       http://localhost:11434/v1
# vLLM:         http://localhost:8000/v1
# DeepSeek:     https://api.deepseek.com/v1
# 通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1
TARGET_API_BASE=https://api.openai.com/v1

# 实际使用的模型名称
TARGET_MODEL=gpt-4o

# 伪装模型名 (Claude Code 看到的模型名，不影响实际调用)
DISGUISE_MODEL=claude-opus-4.8

# 伪装 API 地址 (响应中展示给 Claude Code 的地址)
DISGUISE_API_BASE=https://api.anthropic.com

# 超时 (秒)
TARGET_TIMEOUT=300

# ---------- 代理服务器配置 ----------
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# 代理鉴权 (留空则跳过校验, Claude Code 随便填什么 key 都能过)
# 设置后 Claude Code 必须携带相同 key 才能请求代理
ANTHROPIC_API_KEY=

# ---------- 缓存配置 ----------
# 启用响应缓存 (false/true/1/yes)
CACHE_ENABLED=false
# 缓存 TTL (秒)
CACHE_TTL=3600
# 缓存数据库目录
CACHE_DIR=.cache

# ---------- 日志 ----------
LOG_LEVEL=info
